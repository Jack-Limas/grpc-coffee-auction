# Copy to .env for local development. Every value is optional.
PORT=8080
# Neon / any Postgres. Leave empty to use the in-memory repository.
DATABASE_URL=
# Browser origins allowed to call the API ("*" = any).
CORS_ORIGINS=*
DEMO_MODE=true
# Bots that trade inside the server over native gRPC (keeps the floor alive).
HOUSE_BOTS=true
HOUSE_BOTS_COUNT=4
LOG_RPC=true
